# IntelliTwin AI - Environment Variable Template
# Copy this file to .env and configure values before starting the application.
# NEVER commit real production secrets, API keys, or database passwords to version control.

# Application Environment (development | staging | production)
ENVIRONMENT=development

# Core API Security
# In production, generate a secure 64-character secret using: openssl rand -hex 32
SECRET_KEY=replace_with_a_secure_random_64_character_hex_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Persistence
# Local Development: SQLite fallback
DATABASE_URL=sqlite:///backend/intellitwin.db
# Production Managed PostgreSQL:
# DATABASE_URL=postgresql://user:password@hostname:5432/intellitwin_db

# Administrator Bootstrap (Required in production)
ADMIN_EMAIL=admin@intellitwin.ai
# Set a strong password in production; dev default used only when ENVIRONMENT=development
ADMIN_PASSWORD=

# Machine Learning Artifact Directory
MODELS_DIR=ml-engine/models

# Google Gemini Generative AI (Optional for SOC Copilot)
# If omitted or empty, the platform automatically activates the autonomous offline SOC triage engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Rate Limiting Controls
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_PREDICT_PER_MINUTE=120
RATE_LIMIT_REPORTS_PER_MINUTE=30

# Frontend Configuration (for frontend/.env.local)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
